# Anthropic AI Configuration
ANTHROPIC_API_KEY=your_anthropic_api_key_here

# Flask Configuration
FLASK_ENV=development
FLASK_DEBUG=True
FLASK_APP=app.py

# File Upload Configuration
MAX_FILE_SIZE_MB=10
UPLOAD_FOLDER=/tmp/contract_uploads

# Sui Blockchain Configuration (for future integration)
SUI_NETWORK=testnet
SUI_PRIVATE_KEY=your_sui_private_key_here
SUI_PACKAGE_ID=your_deployed_package_id_here

# Walrus Storage Configuration (for future integration)
WALRUS_PUBLISHER_URL=https://publisher.walrus-testnet.walrus.space
WALRUS_AGGREGATOR_URL=https://aggregator.walrus-testnet.walrus.space

# Google OAuth (for Enoki/zkLogin) (for future integration)
GOOGLE_CLIENT_ID=your_google_client_id
GOOGLE_CLIENT_SECRET=your_google_client_secret

# Optional: Database Configuration
# DATABASE_URL=postgresql://user:password@localhost:5432/decentrasign
# MONGODB_URI=mongodb://localhost:27017/decentrasign
